# ---- Omega Singularity Engine · ตัวแปรแวดล้อม (ทุกตัวมีค่า default แล้ว) ----

# รายชื่อหุ้นที่สแกนอัตโนมัติ (คั่นด้วย ,)
WATCHLIST=SPY,QQQ,IWM,AAPL,NVDA,TSLA,AMD,PLTR,SOFI,INTC,MU,COIN,MARA,SNAP,F

# รอบการสแกน (วินาที) — 180 = 3 นาที
REFRESH_SEC=180

# จำนวนรอบจำลองต่อหุ้นต่อครั้ง (มาก = แม่นขึ้น แต่ช้าลง)
# 4000 เหมาะกับ Render แผนฟรี · 12000-20000 ถ้าเครื่องแรง/มีเวลารอ
SIMS=4000

# เกณฑ์ "สัญญาถูก + ปริมาณสูง"
MIN_VOL=100              # ปริมาณขั้นต่ำต่อวัน
MIN_OI=200               # Open Interest ขั้นต่ำ
MAX_PREMIUM_PCT=0.03     # พรีเมียมไม่เกิน 3% ของราคาหุ้น
MAX_PREMIUM_ABS=5.0      # และไม่เกิน 5 ดอลลาร์
MAX_SPREAD=0.25          # spread ไม่เกิน 25% ของพรีเมียม

# ช่วงอายุสัญญา (วัน)
MIN_DTE=1
MAX_DTE=21
TARGET_DTE=7

# สถิติย้อนหลัง: 126 วันทำการ ≈ 6 เดือน
HIST_WINDOW=126

# ช่วง strike ที่แสดง (สัดส่วนรอบราคาปัจจุบัน) และจำนวน strike สูงสุด
STRIKE_BAND=0.15
MAX_STRIKES=18

# อัตราดอกเบี้ยปลอดความเสี่ยงที่ใช้ใน Black-Scholes
RISK_FREE=0.045

# จำนวน worker ของการสแกนพร้อมกัน (Render แผนฟรี ควร 2 · เครื่องแรงใช้ 4 ได้)
SCAN_WORKERS=2

# อีเมลติดต่อสำหรับ SEC EDGAR (SEC ขอ User-Agent ที่ติดต่อได้)
CONTACT_EMAIL=you@example.com

# คีย์เสริม (ไม่ใส่ก็ใช้ได้ — ระบบจะข้าม)
ALPHAVANTAGE_KEY=
NEWSAPI_KEY=

# ที่เก็บไฟล์สถิติผลจริง (หายเมื่อ redeploy บน Render แผนฟรี)
# TRACK_FILE=omega_track.json
